{
    "name": "thebigcrafter/lucky-player",
    "description": "PocketMine-MP plugin that rewards a lucky joining player",
    "license": "GPL-2.0-only",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/thebigcrafter/Hydrogen"
        },
        {
            "type": "vcs",
            "url": "https://github.com/NhanAZ-Libraries/EcoAPI",
            "no-api": true
        }
    ],
    "require": {
        "nhanaz/ecoapi": "dev-main#23d9d5e5e86c8461664b282d2241febb4b4d2c08",
        "thebigcrafter/hydrogen": "^1.1.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "axolotl-pm/pocketmine-mp": "5.49.1"
    },
    "autoload-dev": {
        "psr-4": {
            "thebigcrafter\\Hydrogen\\": "tools/stubs/Hydrogen/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse -c phpstan.neon.dist"
    }
}
