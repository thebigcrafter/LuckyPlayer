{
    "name": "thebigcrafter/lucky-player",
    "description": "PocketMine-MP plugin that rewards a lucky joining player",
    "license": "GPL-2.0-only",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        }
    ],
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "axolotl-pm/pocketmine-mp": "5.49.1"
    },
    "autoload-dev": {
        "psr-4": {
            "cooldogedev\\BedrockEconomy\\": "tools/stubs/BedrockEconomy/",
            "thebigcrafter\\Hydrogen\\": "tools/stubs/Hydrogen/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse -c phpstan.neon.dist"
    }
}
